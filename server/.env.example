PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

MONGODB_URI=mongodb://localhost:27017/inventory-booking

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RESEND_API_KEY=
EMAIL_FROM="Inventory Booking <noreply@yourdomain.com>"

ANTHROPIC_API_KEY=

ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change-me-admin-password
ADMIN_INVITE_SECRET=change-me-bootstrap-secret

# dev-only: bypass pickup/drop same-day date checks for local testing
DISABLE_DATE_WINDOW_CHECK=false
